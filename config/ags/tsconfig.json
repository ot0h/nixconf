{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "ags/gtk4",
    "lib": [
      "ES2023"
    ],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "paths": {
      "@components/*": [
        "./src/windows/components/*"
      ],
      "@utils": [
        "./src/utils/index.ts"
      ],
      "@windows": [
        "./src/windows/index.ts"
      ]
    },
    "strict": true,
    "target": "ES2020",
    "types": [
      "ags/gtk-4.0"
    ]
  }
}