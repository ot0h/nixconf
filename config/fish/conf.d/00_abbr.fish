# Navegación
abbr -a .. 'cd ..'
abbr -a ... 'cd ../..'
abbr -a cls clear

# Zoxide
abbr -a ze 'zoxide edit'
abbr -a cd z

# Bun
abbr -a bi 'bun install'
abbr -a ba 'bun add'
abbr -a bx bunx
abbr -a br 'bun run'
abbr -a bd 'bun dev'

# Eza
abbr -a ls 'eza --icons always -l'
abbr -a lsa 'eza --icons always -la'
abbr -a lst 'eza -T --icons always -l'
abbr -a lsd 'eza -T -D --icons always'
abbr -a tree 'eza -T --icons always'

# Servidor
abbr -a lsrv 'bunx browser-sync start --server --files "**/*"'
