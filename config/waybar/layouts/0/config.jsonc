{
  "layer": "top",
  "height": 20,
  "spacing": 5,
  // "margin-top": 5,
  // "margin-left": 5,
  // "margin-right": 5,
  "modules-left": [
    "custom/rofi",
    "sway/workspaces",
    "hyprland/workspaces",
    "niri/workspaces",
    "sway/window",
    "hyprland/window",
    // "niri/window",
    "power-profiles-daemon",
    "tray",
    // "custom/bluetui",
    "sway/mode",
    "hyprland/submap",
  ],
  "modules-center": ["clock"],
  "modules-right": [
    // "network",
    // "disk",
    "cpu",
    "custom/cpu_temp",
    "backlight",
    "memory",
    "pulseaudio",
    "battery",
  ],
  "custom/rofi": {
    "format": "󰚌",
    "on-click": "rofi -show drun -disable-history -show-icons",
    "on-click-right": "~/.config/custom_scripts/power.sh",
    "escape": true,
    "tooltip": false,
  },
  "custom/bluetui": {
    "font-size": 16,
    "format": "",
    "on-click": "kitty --class bluetui -e bluetui",
  },
  // Modules configuration
  "sway/workspaces": {
    "disable-scroll": true,
    "active-only": false,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{icon}",
    "format-icons": {
      "focused": "󰨑",
      "urgent": "󰜋",
      "default": "󰜌",
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
    },
  },
  "sway/window": {
    "format": " 󰣆  {app_id}",
    "separate-outputs": true,
    "tooltip": false,
  },
  "sway/mode": {
    "format": " {}",
    "max-length": 50,
  },
  "hyprland/workspaces": {
    "disable-scroll": false,
    "active-only": false,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{icon}",
    "format-icons": {
      "active": "󰨑",
      "default": "󰜋",
      "empty": "󰜌",
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
    },
  },
  "hyprland/window": {
    "format": " 󰣆  {class}",
    "separate-outputs": true,
    "icon": false,
    "tooltip": false,
  },
  "hyprland/submap": {
    "format": " {}",
    "max-length": 50,
  },
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "󰨑 ",
      "default": "󰜋 ",
      "empty": "󰜌 ",
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
    },
  },
  "niri/window": {
    "format": " 󰣆  {title}",
    "separate-outputs": true,
    "icon": false,
    "tooltip": false,
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8,
  },
  "disk": {
    "format": "   {free}",
    "interval": 20,
  },
  "cpu": {
    "format": "   {usage}%",
    "tooltip": false,
    "interval": 1,
  },
  "custom/cpu_temp": {
    "exec": "~/.config/waybar/scripts/waybarTemp.sh",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "tooltip": false,
  },
  "backlight": {
    // "device": "acpi_video1",
    "format": " 󰞏  {percent}%",
    "tooltip": false,
    "on-click-right": "~/.config/custom_scripts/wlsunset.sh",
  },
  "memory": {
    "interval": 3,
    "format": " 󰚤  {percentage}% ",
  },
  "pulseaudio": {
    // "scroll-step": 1, // %, can be a float
    "format": " {icon} {volume}%",
    "format-muted": "   {volume}%",
    "format-bluetooth": " 󰂰  {volume}%",
    "format-bluetooth-muted": " 󰂲  {volume}%",
    "format-source": "{volume}% ",
    "format-icons": {
      "headphone": "󰋋",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""],
    },
    "on-click": "kitty --class wiremix -e wiremix",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip": false,
    "max-volume": 130,
  },
  "battery#bat2": {
    "bat": "BAT2",
  },
  "battery": {
    "interval": 1,
    "states": {
      "good": 99,
      "warning": 30,
      "critical": 20,
    },
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "format": " {icon} {capacity}%",
    "format-critical": " {icon} {capacity}%!!",
    "format-warning": " {icon} {capacity}%",
    "format-full": " {icon} {capacity}%",
    "format-charging": " 󰂅  {capacity}%",
    "format-charging-warning": " 󰢝  {capacity}%",
    "format-charging-critical": " 󰢜  {capacity}%",
    "format-plugged": " 󰂅  {capacity}%",
    "format-alt": " 󱧥  {time}",
    "tooltip": false,
  },
  "network": {
    "interval": 2,
    "format": " 󱘖  {bandwidthDownBits}",
    "format-wifi": " {icon}  {bandwidthDownBits}",
    "format-ethernet": " 󰈀  {bandwidthDownBits}",
    "format-icons": ["󰤫", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip": false,
    "states": {
      "normal": 25,
    },
  },
  "clock": {
    // "timezone": "America/New_York",
    "format": "   {:%a %d | %H:%M}",
    "tooltip": false,
    "interval": 1,
  },
  "power-profiles-daemon": {
    "format": "<span>{icon}</span>",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": false,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": "",
    },
  },
}
